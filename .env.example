# Copy this file to `.env` and fill in your Firebase web-app config to enable the
# online leaderboard. Without it the game runs fully and just keeps your best
# score locally. Find these values in Firebase console → Project settings →
# "Your apps" → SDK setup and configuration.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Realtime Database URL. Recommended (and required for a non-US region). If
# omitted it's inferred as https://<project-id>-default-rtdb.firebaseio.com
VITE_FIREBASE_DB_URL=
