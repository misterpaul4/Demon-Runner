# Copy this file to `.env` and fill in your Firebase web-app config to enable the
# online leaderboard. Without it the game runs fully and just keeps your best
# score locally. Find these values in Firebase console → Project settings →
# "Your apps" → SDK setup and configuration.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Only needed if your Realtime Database is NOT the default instance
# (e.g. it lives in a non-US region). Otherwise it's inferred as
# https://<project-id>-default-rtdb.firebaseio.com
VITE_FIREBASE_DATABASE_URL=
